{
  "name": "employee-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Remote Employee Monitoring & Time Tracking Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/admin-web run dev",
    "build:contracts": "npm run --workspace=packages/contracts build",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:seed": "tsx ./prisma/seed.ts",
    "test": "npm run --workspace=apps/api test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
